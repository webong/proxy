{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portable HTTP profile v1",
  "type": "object",
  "required": [
    "version"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "connect_timeout_seconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 300
    },
    "request_timeout_seconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 300
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "http": {
          "type": "string",
          "pattern": "^(?:https?://(?:(?:[A-Za-z0-9._~!$&'()*+,;=-]|%[2-9A-Fa-f][0-9A-Fa-f])*(?::(?:[A-Za-z0-9._~!$&'()*+,;=:-]|%[2-9A-Fa-f][0-9A-Fa-f])*)?@)?|socks5h?://(?:(?:[A-Za-z0-9._~!$&'()*+,;=-]|%[2-9A-Fa-f][0-9A-Fa-f]){1,255}:(?:[A-Za-z0-9._~!$&'()*+,;=:-]|%[2-9A-Fa-f][0-9A-Fa-f]){1,255}@)?)(?:\\[[0-9A-Fa-f:.]+\\]|[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*\\.?)(?::(?:0{0,4}[1-9]|0{0,3}[1-9][0-9]|0{0,2}[1-9][0-9]{2}|0?[1-9][0-9]{3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?/?$",
          "not": {
            "pattern": "[\u0000- \u007f\u2028\u2029]"
          }
        },
        "https": {
          "type": "string",
          "pattern": "^(?:https?://(?:(?:[A-Za-z0-9._~!$&'()*+,;=-]|%[2-9A-Fa-f][0-9A-Fa-f])*(?::(?:[A-Za-z0-9._~!$&'()*+,;=:-]|%[2-9A-Fa-f][0-9A-Fa-f])*)?@)?|socks5h?://(?:(?:[A-Za-z0-9._~!$&'()*+,;=-]|%[2-9A-Fa-f][0-9A-Fa-f]){1,255}:(?:[A-Za-z0-9._~!$&'()*+,;=:-]|%[2-9A-Fa-f][0-9A-Fa-f]){1,255}@)?)(?:\\[[0-9A-Fa-f:.]+\\]|[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*\\.?)(?::(?:0{0,4}[1-9]|0{0,3}[1-9][0-9]|0{0,2}[1-9][0-9]{2}|0?[1-9][0-9]{3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?/?$",
          "not": {
            "pattern": "[\u0000- \u007f\u2028\u2029]"
          }
        },
        "no_proxy": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:\\*|\\.?[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*)$",
            "not": {
              "anyOf": [
                {
                  "pattern": "[\u0000- \u007f\u2028\u2029]"
                },
                {
                  "pattern": "^\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9][0-9]?|0)(?:\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9][0-9]?|0)){3}$"
                }
              ]
            }
          }
        }
      }
    }
  }
}
