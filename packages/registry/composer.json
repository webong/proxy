{
    "name": "webong/proxy-registry",
    "description": "Storage-neutral endpoint, destination and profile repository contracts.",
    "type": "library",
    "version": "0.4.0",
    "license": "MIT",
    "require": {
        "php": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "Webong\\Proxy\\Registry\\": "src/Registry/"
        },
        "classmap": [
            "src/"
        ]
    },
    "conflict": {
        "webong/proxy": "<0.4.0"
    },
    "extra": {
        "source-plugin": {
            "surfaces": {
                "php": {
                    "include": [
                        "src/**",
                        "README.md",
                        "LICENSE"
                    ]
                }
            }
        }
    }
}
