{
    "name": "webong/proxy-transport",
    "description": "Framework-neutral PHP HTTP profiles, TCP proxy dialers and UDP associations.",
    "type": "library",
    "version": "0.4.0",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.10"
    },
    "autoload": {
        "psr-4": {
            "Webong\\Proxy\\Connection\\": "src/Connection/",
            "Webong\\Proxy\\Http\\": "src/Http/",
            "Webong\\Proxy\\Tcp\\": "src/Tcp/",
            "Webong\\Proxy\\Udp\\": "src/Udp/"
        }
    },
    "extra": {
        "source-plugin": {
            "surfaces": {
                "php": {
                    "include": [
                        "src/**",
                        "README.md",
                        "LICENSE"
                    ]
                }
            }
        }
    },
    "conflict": {
        "webong/proxy": "<0.4.0"
    }
}
