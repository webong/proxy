{
    "name": "webong/proxy-bootstrap",
    "description": "Install development tooling before resolving the optional Laravel package.",
    "type": "project",
    "license": "MIT",
    "require": {
        "webong/composer-source-plugin": "^0.5.0"
    },
    "config": {
        "allow-plugins": {
            "webong/composer-source-plugin": true,
            "pestphp/pest-plugin": true
        }
    }
}
