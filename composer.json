{
    "name": "webong/proxy-workspace",
    "description": "Development workspace for Proxy PHP, Laravel and Go components.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "webong/composer-source-plugin": "^0.4.0",
        "webong/proxy": "^0.4.0",
        "webong/proxy-laravel": "^0.4.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Webong\\Proxy\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php scripts/check_php_api.php",
            "@php scripts/check_php_api.php --registry",
            "pest"
        ]
    },
    "extra": {
        "source-plugin": {
            "workspaces": [
                "php",
                "adapters/laravel"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "webong/composer-source-plugin": true
        },
        "sort-packages": true
    }
}
