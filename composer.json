{
    "name": "webong/proxy",
    "description": "Framework-neutral HTTP profiles, TCP/UDP proxy transports and storage-neutral registry contracts.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.10"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "webong/composer-source-plugin": "^0.4.0",
        "webong/proxy-laravel": "^0.4.0"
    },
    "autoload": {
        "psr-4": {
            "Webong\\Proxy\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webong\\Proxy\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php scripts/check_php_api.php",
            "@php scripts/check_php_api.php --registry",
            "pest"
        ]
    },
    "extra": {
        "source-plugin": {
            "workspaces": [
                "packages/laravel"
            ],
            "surfaces": {
                "php": {
                    "include": [
                        "src/**",
                        "README.md",
                        "CHANGELOG.md",
                        "LICENSE",
                        "spec/**"
                    ]
                }
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "webong/composer-source-plugin": true
        },
        "sort-packages": true
    },
    "archive": {
        "exclude": [
            "/packages",
            "/tests",
            "/scripts",
            "/.github",
            "/composer.bootstrap.json",
            "/composer.bootstrap.lock",
            "/composer.lock",
            "/Makefile",
            "/phpunit.xml.dist",
            "/go.mod",
            "/httpclient",
            "/httpprofile",
            "/socketprofile",
            "/tcpdial",
            "/udpdial",
            "/internal",
            "/vendor",
            "/.phpunit.cache",
            "/composer-source.lock"
        ]
    },
    "version": "0.4.0",
    "conflict": {
        "webong/proxy-transport": "*",
        "webong/proxy-registry": "*"
    }
}
