{
    "name": "webong/proxy",
    "description": "Laravel endpoint registries, persistence and webhook integration with portable Proxy transports.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3 || ^8.4",
        "guzzlehttp/guzzle": "^7.10",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "spatie/laravel-webhook-client": "^3.5",
        "spatie/laravel-webhook-server": "^3.10",
        "webong/proxy-transport": "^0.4.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "webong/composer-source-plugin": "^0.4.0"
    },
    "autoload": {
        "psr-4": {
            "Webong\\Proxy\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webong\\Proxy\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php scripts/check_php_api.php",
            "pest"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Webong\\Proxy\\WebProxyServiceProvider"
            ]
        },
        "source-plugin": {
            "workspaces": [
                "packages/transport"
            ],
            "surfaces": {
                "php": {
                    "include": [
                        "src/**",
                        "config/**",
                        "database/**",
                        "README.md",
                        "CHANGELOG.md",
                        "LICENSE",
                        "spec/**"
                    ]
                }
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "webong/composer-source-plugin": true
        },
        "sort-packages": true
    },
    "archive": {
        "exclude": [
            "/packages",
            "/tests",
            "/scripts",
            "/.github",
            "/composer.bootstrap.json",
            "/composer.bootstrap.lock",
            "/composer.lock",
            "/Makefile",
            "/phpunit.xml.dist",
            "/go.mod",
            "/httpclient",
            "/httpprofile",
            "/socketprofile",
            "/tcpdial",
            "/udpdial",
            "/internal"
        ]
    }
}
